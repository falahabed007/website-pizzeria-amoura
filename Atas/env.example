# ══════════════════════════════════════════════════════
# ATAS Döner & Pizza – Umgebungsvariablen
# Diese Datei NIEMALS mit echten Werten auf GitHub hochladen!
# Nur .env.example hochladen – die echte .env bleibt lokal / in Render.
# ══════════════════════════════════════════════════════

# MongoDB Atlas Connection String
# Format: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/atas-doener
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/atas-doener

# Stripe Zahlungen
STRIPE_SECRET_KEY=sk_live_DEIN_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_DEIN_WEBHOOK_SECRET

# Resend E-Mail
RESEND_API_KEY=re_DEIN_RESEND_API_KEY
EMAIL_FROM=bestellungen@atas-beckum.de
RESTAURANT_EMAIL=info@atas-beckum.de

# PrintNode Bondrucker (optional)
PRINTNODE_API_KEY=DEIN_PRINTNODE_API_KEY
PRINTNODE_PRINTER_ID=123456

# Admin Dashboard
ADMIN_PASSWORD=AtasBeckum2025!
ADMIN_TOKEN_SECRET=AtasGeheimToken2025xyzABCDEFGHIJKLMNOPQRSTUVWXYZ

# WhatsApp Button (ohne + oder Leerzeichen, mit Ländervorwahl 49)
WHATSAPP_NUMBER=4915123456789

# Frontend URL (nach Render-Deploy eintragen)
FRONTEND_URL=https://atas-doener-pizza.onrender.com

# Server Port
PORT=3001
