# ══════════════════════════════════════════════
# Pizzeria Pinocchio – Umgebungsvariablen
# ══════════════════════════════════════════════
# Kopiere diese Datei als ".env" und fülle alle Felder aus.

# ── Datenbank ──────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORT@cluster.mongodb.net/pinocchio

# ── Frontend URL (Render / eigene Domain) ──────
FRONTEND_URL=https://pinocchio-ennigerloh.de

# ── Stripe (Online-Zahlung) ────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_ACCOUNT=acct_...   # Vendor-ID des Restaurants (optional)

# ── E-Mail via Resend ──────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=bestellungen@pinocchio-ennigerloh.de

# ── E-Mail-Empfänger ───────────────────────────
RESTAURANT_EMAIL=restaurant@pinocchio-ennigerloh.de
OWNER_EMAIL=inhaber@pinocchio-ennigerloh.de

# ── Steuer (für Monatsbericht) ─────────────────
STEUERNUMMER=123/456/78901

# ── Admin-Zugang ───────────────────────────────
ADMIN_PASSWORD=Pinocchio2025!
ADMIN_TOKEN_SECRET=PinocchioGeheimToken2025xyzABCDEFGHIJKLMNOP

# ── Server Port ────────────────────────────────
PORT=3000

# ── Drucker (optional) ─────────────────────────
# PRINTNODE_API_KEY=...
# PRINTNODE_PRINTER_ID=...
